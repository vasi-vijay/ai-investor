# Copy to .env (git-ignored) and fill in. NEVER paste these values into a chat, issue or commit.

# --- database (docker compose) ---
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root

# --- dashboard login (required; use a long random value) ---
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=change-me-long-random

# --- data & AI selection ---
DATA_SOURCE=MOCK            # MOCK needs no credentials. GROWW needs a Groww Trading API account (+ market-data subscription).
MOCK_REPLAY=true            # step through synthetic days so the pipeline runs outside market hours
AI_PROVIDER=MOCK_HEURISTIC  # CLAUDE to use the Anthropic API (needs ANTHROPIC_API_KEY); MOCK_HEURISTIC is NOT Claude
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# --- Groww (only with DATA_SOURCE=GROWW). Provide ONE of: access token, or api key + (totp secret | api secret) ---
GROWW_ENABLED=false
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_TOTP_SECRET=
GROWW_API_SECRET=

# --- set true when serving over HTTPS ---
COOKIE_SECURE=false
